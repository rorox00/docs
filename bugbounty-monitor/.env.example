###############################################################################
# Bug Bounty Monitor — configuration
#
# Copy to `.env` and adjust. Every value below is optional except the database
# connection; the defaults shown are what the application uses when a variable
# is absent.
###############################################################################

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
# Public URL of this instance; used in notification and digest links.
APP_URL=http://localhost:3000

DATABASE_URL=postgres://bbm:bbm@localhost:5432/bbm
DATABASE_POOL_MAX=10

# Required for the background worker and the job queue. The app degrades to
# running jobs inline if Redis is unreachable.
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Authentication
#
# The FIRST account registered on an instance becomes its administrator.
# Alternatively set the two BOOTSTRAP_ variables to create one automatically.
# ---------------------------------------------------------------------------
# CHANGE THIS. Generate with: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string
AUTH_COOKIE_NAME=bbm_session
SESSION_TTL_HOURS=336
ALLOW_SIGNUP=true
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Crawler politeness
#
# This tool only reads publicly published disclosure information. The defaults
# are deliberately conservative: raise them only if you understand the load you
# are placing on the sites you monitor.
# ---------------------------------------------------------------------------
# Identify yourself honestly and give site owners a way to reach you.
CRAWLER_USER_AGENT=BugBountyMonitor/1.0 (+https://example.com/bot; contact: you@example.com)
CRAWLER_CONTACT_EMAIL=you@example.com

CRAWLER_ENABLED=true
CRAWLER_RESPECT_ROBOTS=true
CRAWLER_REQUEST_TIMEOUT_MS=15000
CRAWLER_MAX_RETRIES=2
CRAWLER_RETRY_BASE_MS=1000
# Minimum gap between two requests to the same host.
CRAWLER_PER_HOST_DELAY_MS=4000
# Ceiling on concurrent outbound requests across all hosts.
CRAWLER_GLOBAL_CONCURRENCY=4
CRAWLER_MAX_BODY_BYTES=2500000
CRAWLER_CACHE_TTL_MINUTES=720
CRAWLER_MAX_PATHS_PER_DOMAIN=14

# ---------------------------------------------------------------------------
# Scheduling (cron expressions, evaluated by the worker)
# ---------------------------------------------------------------------------
SCHEDULE_DISCOVERY_CRON=0 */6 * * *
SCHEDULE_VERIFY_CRON=30 3 * * *
SCHEDULE_DIGEST_CRON=0 8 * * *
# Re-check a program once it has not been verified for this long.
VERIFY_INTERVAL_HOURS=72
# Programs discovered (or launched) inside this window count as "new".
NEW_PROGRAM_WINDOW_DAYS=30
# Programs scoring below this are not published; raise it to be stricter.
MIN_CONFIDENCE_TO_PUBLISH=40

# ---------------------------------------------------------------------------
# Discovery sources
# ---------------------------------------------------------------------------
ENABLE_SOURCE_SEEDS=true
ENABLE_SOURCE_WELLKNOWN=true
ENABLE_SOURCE_SITEMAP=true
ENABLE_SOURCE_RSS=true
ENABLE_SOURCE_SEARCH=true
# Certificate transparency (crt.sh) is off by default: it is a community
# service, so enable it deliberately.
ENABLE_SOURCE_CRTSH=false

# Path to your own seed list (JSON array or one domain per line).
# DISCOVERY_SEED_FILE=./seeds.txt

# Search provider: brave | google_cse | bing | serpapi | none
# The search source is inert until a provider and key are set.
SEARCH_PROVIDER=none
# SEARCH_API_KEY=
# GOOGLE_CSE_ID=
SEARCH_RESULTS_PER_QUERY=20
SEARCH_MAX_QUERIES_PER_RUN=12

# ---------------------------------------------------------------------------
# Notifications
#
# In-app notifications always work. The others activate when configured.
# ---------------------------------------------------------------------------
NOTIFY_EMAIL_ENABLED=false
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM=Bug Bounty Monitor <no-reply@example.com>

# Chat channels — set a webhook/token to enable.
# NOTIFY_SLACK_WEBHOOK_URL=
# NOTIFY_DISCORD_WEBHOOK_URL=
# NOTIFY_TELEGRAM_BOT_TOKEN=
# NOTIFY_TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
# pretty | json
LOG_FORMAT=pretty

# ---------------------------------------------------------------------------
# Docker Compose only
# ---------------------------------------------------------------------------
POSTGRES_USER=bbm
POSTGRES_PASSWORD=bbm
POSTGRES_DB=bbm
POSTGRES_PORT=5432
REDIS_PORT=6379
WEB_PORT=3000
