{
  "name": "bugbounty-monitor",
  "version": "1.0.0",
  "private": true,
  "description": "Monitoring platform that discovers newly launched self-hosted bug bounty and responsible disclosure programs.",
  "type": "module",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "dev": "next dev -p ${PORT:-3000}",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "worker": "tsx src/jobs/worker.ts",
    "worker:dev": "tsx watch src/jobs/worker.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "discover": "tsx src/cli/discover.ts",
    "verify": "tsx src/cli/verify.ts",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bullmq": "^5.34.5",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "next": "^15.1.4",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "drizzle-kit": "^0.30.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
